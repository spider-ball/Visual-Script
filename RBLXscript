local function setFov(value)
	value = math.clamp(value, FOV_MIN, FOV_MAX)
	currentFov = value

	local percent = (value - FOV_MIN) / (FOV_MAX - FOV_MIN)

	fovFill.Size = UDim2.new(percent, 0, 0, 6)
