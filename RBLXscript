local isOpen, isAnimating = false, false

local function setMenuOpen(open)
	if isAnimating then return end

	isAnimating = true
	isOpen = open

	local targetSize = open
		and UDim2.new(0, currentPanelSize.X, 0, currentPanelSize.Y)
		or UDim2.new(0, 0, 0, 0)

	local info = open
		and TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		or TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	if open then
		menu.Visible = true
	end

	local tween = TweenService:Create(menu, info, {
		Size = targetSize
	})

	tween:Play()

	tween.Completed:Connect(function()
		if not open then
			menu.Visible = false
		end

		isAnimating = false
	end)
end

