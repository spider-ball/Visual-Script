	"PinkSky", "Pink1Sky", "SunsetSky", "Sunset1Sky", "DarkSunsetSky",
	"OvercastSky", "Overcast1Sky", "Overcast2Sky", "Overcast3Sky", "PurpleSky", "Purple2Sky", "Purple3Sky",
