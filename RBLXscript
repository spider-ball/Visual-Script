local function selectSky(name)
	if name == "DefaultSky" then
		applyDefaultSky()
	else
		local data = SKY_DATA[name]
		if data then
			applyCustomSky(name, data[1], data[2], data[3])
		else
			applyDefaultSky()
		end
	end
	saveSettingsDelayed()
end

