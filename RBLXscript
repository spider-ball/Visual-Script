-- ===== Управление Sky =====

local originalSky, customSky

local function findOriginalSky()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") and not isCustomSkyName(child.Name) then return child end
	end
end

originalSky = findOriginalSky()

if not originalSky then
	originalSky = Instance.new("Sky")
	originalSky.Name = "DefaultSky"
	originalSky.Parent = Lighting
end

local CUSTOM_COLOR_CORRECTION_NAME = "FTAP_ColorCorrection"

local function clearCustomColorCorrection()
	local cc = Lighting:FindFirstChild(CUSTOM_COLOR_CORRECTION_NAME)
	if cc then cc:Destroy() end
end

local function applyColorCorrection(settings)
	clearCustomColorCorrection()

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = CUSTOM_COLOR_CORRECTION_NAME
	cc.Brightness = settings.Brightness or 0
	cc.Contrast = settings.Contrast or 0
	cc.Saturation = settings.Saturation or 0
	cc.TintColor = settings.TintColor or Color3.new(1, 1, 1)
	cc.Enabled = true
	cc.Parent = Lighting
end

local function clearCustomSky()
	if customSky then
		customSky:Destroy()
		customSky = nil
	end
	cleanupCustomSky()
	clearCustomColorCorrection()
end

local currentSkyName = "DefaultSky"
local currentFov = 70

local function applyDefaultSky()
	clearCustomSky()
	if originalSky and not originalSky.Parent then originalSky.Parent = Lighting end
	setActiveSkyButton(defaultSkyButton)
	currentSkyName = "DefaultSky"
end

local function applyCustomSky(name, textures, button, colorCorrection)
	clearCustomSky()
	if originalSky then originalSky.Parent = nil end

	customSky = Instance.new("Sky")
	customSky.Name = "FTAP_CustomSky"
	customSky.SkyboxFt = textures.Front
	customSky.SkyboxRt = textures.Right
	customSky.SkyboxBk = textures.Back
	customSky.SkyboxUp = textures.Up
	customSky.SkyboxLf = textures.Left
	customSky.SkyboxDn = textures.Down
	customSky.Parent = Lighting

	if colorCorrection then
		applyColorCorrection(colorCorrection)
	end

	setActiveSkyButton(button)
	currentSkyName = name
end

