local function isCustomSkyName(name)
	for _, n in ipairs(CUSTOM_SKY_NAMES) do
		if name == n then return true end
	end
	return false
end

local function cleanupCustomSky()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") and isCustomSkyName(child.Name) then
			child:Destroy()
		end
	end
end

