-- ===== Система сохранения =====

function saveSettings()
	local data = {
		sky = currentSkyName,
		fov = math.floor(currentFov),
		iconX = icon.Position.X.Offset,
		iconY = icon.Position.Y.Offset,
		menuW = math.floor(currentPanelSize.X),
		menuH = math.floor(currentPanelSize.Y),
	}

	local ok, err = pcall(function()
		writefile(
			SETTINGS_FILE,
			HttpService:JSONEncode(data)
		)
	end)

	if not ok then
		warn("[FTAP] Save error:", err)
	end
end

function saveSettingsDelayed()
	if saveDebounce then
		return
	end

	saveDebounce = true

	task.delay(0.5, function()
		saveDebounce = false
		saveSettings()
	end)
end

local function applyLoadedSettings(data)
	if type(data) ~= "table" then
		return
	end

	if data.fov then
		setFov(data.fov)
	end

	if data.sky and data.sky ~= "DefaultSky" then
		local entry = SKY_DATA[data.sky]

		if entry then
			applyCustomSky(data.sky, entry[1], entry[2], entry[3])
		else
			applyDefaultSky()
		end
	else
		applyDefaultSky()
	end

	if data.iconX ~= nil and data.iconY ~= nil then
		local vp = workspace.CurrentCamera.ViewportSize

		local newX = math.clamp(
			data.iconX,
			0,
			vp.X - iconSize
		)

		local newY = math.clamp(
			data.iconY,
			0,
			vp.Y - iconSize
		)

		icon.Position = UDim2.new(0, newX, 0, newY)
	end

	if data.menuW ~= nil and data.menuH ~= nil then
		currentPanelSize = Vector2.new(
			math.clamp(data.menuW, minPanelSize.X, maxPanelSize.X),
			math.clamp(data.menuH, minPanelSize.Y, maxPanelSize.Y)
		)
	end
end

local function loadSettings()
	if not isfile or not isfile(SETTINGS_FILE) then
		return
	end

	local ok, raw = pcall(readfile, SETTINGS_FILE)

	if not ok or not raw then
		return
	end

	local ok2, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)

	if not ok2 or type(data) ~= "table" then
		return
	end

	applyLoadedSettings(data)
end

loadSettings()
