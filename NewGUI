local function asset(id)
	if type(id) == "number" then return "rbxassetid://" .. id end
	if type(id) == "string" and id:match("^%d+$") then return "rbxassetid://" .. id end
	return id
end

local function makeGroup(name, zIndex)
	local g = Instance.new("Frame")
	g.Name = name
	g.AnchorPoint = Vector2.new(0.5, 0.5)
	g.Position = UDim2.new(0.5, 0, 0.5, 0)
	g.Size = UDim2.new(1, 0, 1, 0)
	g.BackgroundTransparency = 1
	g.BorderSizePixel = 0
	g.ZIndex = zIndex
	g.Parent = screenGui
	return g
end

local function makePart(name, parent, size, pos, color, cornerScale)
	local p = Instance.new("Frame")
	p.Name = name
	p.Size = size
	p.Position = pos
	p.AnchorPoint = Vector2.new(0.5, 0.5)
	p.BackgroundColor3 = color
	p.BorderSizePixel = 0
	p.ZIndex = Z_OTHER
	p.Parent = parent

	if cornerScale then
		local c = Instance.new("UICorner")
		c.CornerRadius = cornerScale
		c.Parent = p
	end
	return p
end

local function makeLine(name, parent, isHorizontal, length, position)
	local line = Instance.new("Frame")
	line.Name = name
	if isHorizontal then
		line.Size = UDim2.new(length, 0, 0, LINE_THICKNESS)
	else
		line.Size = UDim2.new(0, LINE_THICKNESS, length, 0)
	end
	line.Position = position
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.BackgroundColor3 = COLOR_LINES
	line.BorderSizePixel = 0
	line.ZIndex = Z_OUTLINE
	line.Parent = parent
	return line
end

local textObjects = {}

local function registerText(obj, baseSize)
	obj.TextScaled = false
	obj.TextSize = baseSize * BASE_SCALE
	table.insert(textObjects, { obj = obj, base = baseSize })
end

