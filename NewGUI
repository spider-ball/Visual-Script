-- Панели вкладок со скроллом
-- Вкладка = большая панель  (Sec{S}Tab{N})
-- Плашка-заголовок          (Sec{S}Tab{N}Title), внутри неё иконка вкладки
----------------------------------------------------------------

-- Content всегда равен размеру меню, поэтому каждая панель сохраняет свои
-- исходные размер и позицию; окно скролла лишь показывает часть Content.
local scrollSections = {}

local function syncScroll()
	local w = mainGroup.AbsoluteSize.X
	local h = mainGroup.AbsoluteSize.Y
	for _, e in ipairs(scrollSections) do
		e.content.Size = UDim2.fromOffset(w, h)
		e.content.Position = UDim2.fromOffset(-SCROLL_LEFT * w, -SCROLL_TOP * h)
		e.sf.CanvasSize = UDim2.fromOffset(0, ((ROWS - 1) * ROW_STEP + SCROLL_H) * h)
	end
end
mainGroup:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncScroll)

local function makeSectionScroll(name)
	local sf = Instance.new("ScrollingFrame")
	sf.Name = name
	sf.AnchorPoint = Vector2.new(0.5, 0.5)
	sf.Size = UDim2.new(SCROLL_W, 0, SCROLL_H, 0)
	sf.Position = UDim2.new(SCROLL_LEFT + SCROLL_W / 2, 0, SCROLL_TOP + SCROLL_H / 2, 0)
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.ScrollBarThickness = SCROLL_BAR_THICK
	sf.ZIndex = Z_OTHER
	sf.Visible = false
	sf.Parent = mainGroup

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ZIndex = Z_OTHER
	content.Parent = sf

	table.insert(scrollSections, { sf = sf, content = content })
	return sf, content
end

-- row = 1 - исходное место; каждый следующий ряд сдвинут вниз на ROW_STEP.
local function makeSectionPanel(name, parent, row, size, pos, corner, text)
	local p = makePart(name, parent, size,
		UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale + (row - 1) * ROW_STEP, pos.Y.Offset),
		SEC_COLOR)

	local c = Instance.new("UICorner")
	c.CornerRadius = corner
	c.Parent = p

	if text then
		local lbl = Instance.new("TextLabel")
		lbl.Name = "Label"
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = text
		lbl.Font = Enum.Font.GothamBold
		lbl.TextColor3 = Color3.fromRGB(0, 0, 0)
		lbl.ZIndex = Z_OTHER
		lbl.Parent = p
		registerText(lbl, TEXT_BASE_LABEL)
	end

	return p
end

local function tabIconId(section, index)
	local list = TAB_ICONS[section]
	local id = list and list[index]
	if id and id ~= 0 and id ~= "" then return id end
	return TAB_ICON_DEFAULT
end

local function addTitleIcon(title, id)
	local ic = Instance.new("ImageLabel")
	ic.Name = "Icon"
	ic.AnchorPoint = Vector2.new(0.5, 0.5)
	ic.Position = TAB_ICON_POS
	ic.Size = TAB_ICON_SIZE
	ic.BackgroundTransparency = 1
	ic.BorderSizePixel = 0
	ic.Image = asset(id)
	ic.ScaleType = Enum.ScaleType.Fit
	ic.ZIndex = Z_OTHER
	ic.Parent = title
end

local tabCounter = 0
for s = 1, BUTTON_COUNT do
	local sf, content = makeSectionScroll("Sec" .. s .. "Scroll")
	sections[s] = sf

	for row = 1, ROWS do
		for col = 1, 2 do
			tabCounter = tabCounter + 1
			local isLeft = (col == 1)
			local index = (row - 1) * 2 + col

			makeSectionPanel("Sec" .. s .. "Tab" .. tabCounter, content, row,
				isLeft and SEC_P1_SIZE or SEC_P2_SIZE,
				isLeft and SEC_P1_POS or SEC_P2_POS,
				SEC_CORNER_B)

			local title = makeSectionPanel("Sec" .. s .. "Tab" .. tabCounter .. "Title", content, row,
				SEC_T_SIZE,
				isLeft and SEC_T1_POS or SEC_T2_POS,
				SEC_CORNER_T, TAB_TITLE_PREFIX .. tabCounter)

			addTitleIcon(title, tabIconId(s, index))
		end
	end
end
