-- [4.1] ХРАНИЛИЩЕ РАЗДЕЛОВ
local tabPanels  = {}
local currentTab = nil

-- [4.2] ПЕРЕКЛЮЧЕНИЕ РАЗДЕЛОВ
local function openTab(i)
	local list = tabPanels[i]
	if not list then return end
	if currentTab == i then return end

	if currentTab and tabPanels[currentTab] then
		for _, p in ipairs(tabPanels[currentTab]) do
			p.Visible = false
		end
	end

	for _, p in ipairs(list) do
		p.Visible = true
	end

	currentTab = i
end

-- [4.3] КНОПКИ (верхняя панель)
local topButtons = {}

local function updateButtonVisuals()
	for i, btn in ipairs(topButtons) do
		if i == currentTab then
			btn.BackgroundColor3 = BUTTON_ACTIVE_COLOR
		else
			btn.BackgroundColor3 = BUTTON_INACTIVE_COLOR
		end
	end
end

for i = 1, BUTTON_COUNT do
	local btnX = BUTTON_START_X + (i - 1) * (BUTTON_WIDTH + BUTTON_GAP)

	local btn = Instance.new("TextButton")
	btn.Name = "TopButton" .. i
	btn.Size = UDim2.new(BUTTON_WIDTH * BAR_W, 0, BUTTON_HEIGHT * BAR_H, 0)
	btn.AnchorPoint = Vector2.new(0, 0.5)
	btn.Position = UDim2.new(BAR_X + btnX * BAR_W, 0, BAR_Y + BUTTON_START_Y * BAR_H, 0)
	btn.BackgroundColor3 = BUTTON_COLOR
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false
	btn.Text = "Раздел " .. i
	btn.Font = Enum.Font.GothamBold
	btn.TextColor3 = Color3.fromRGB(0, 0, 0)
	btn.ZIndex = Z_OTHER
	btn.Parent = sideTopGroup

	registerText(btn, TEXT_BASE_BUTTON)

	local glow = Instance.new("Frame")
	glow.Name = "Glow"
	glow.Size = UDim2.new(1, 0, 1, 0)
	glow.BackgroundColor3 = GLOW_COLOR
	glow.BackgroundTransparency = 1
	glow.BorderSizePixel = 0
	glow.ZIndex = Z_OTHER
	glow.Parent = btn

	local function glowOn()
		glow.BackgroundTransparency = GLOW_TRANSPARENCY
	end

	local function glowOff()
		TweenService:Create(glow, TweenInfo.new(GLOW_FADE_TIME), { BackgroundTransparency = 1 }):Play()
	end

	btn.MouseButton1Down:Connect(glowOn)
	btn.MouseButton1Up:Connect(glowOff)
	btn.MouseLeave:Connect(glowOff)
	btn.Activated:Connect(function()
		openTab(i)
		updateButtonVisuals()
	end)

	topButtons[i] = btn
end

