----------------------------------------------------------------
-- ГЛАВНЫЙ ЦИКЛ
----------------------------------------------------------------
local tabCounter = 0
for s = 1, BUTTON_COUNT do
	local sf, content = makeSectionScroll("Sec" .. s .. "Scroll")
	sections[s] = sf

	local columns = { {}, {} }

	local function relayoutColumn(col)
		local yOff = 0
		for r = 1, ROWS do
			local t = columns[col][r]
			if t then
				local function moveTo(el, baseY)
					el.Position = UDim2.new(
						el.Position.X.Scale, el.Position.X.Offset,
						baseY + yOff, el.Position.Y.Offset)
				end
				moveTo(t.body,         t.baseBodyY)
				moveTo(t.bodyOutline,  t.baseBodyY)
				moveTo(t.title,        t.baseTitleY)
				moveTo(t.titleOutline, t.baseTitleY)
				moveTo(t.decor,        t.baseDecorY)
				moveTo(t.vline,        t.baseVlineY)

				if t.closed then
					yOff = yOff - TAB_COLLAPSE_SHIFT_Y
				end
			end
		end
	end

	for row = 1, ROWS do
		for col = 1, 2 do
			tabCounter = tabCounter + 1
			local myId = tabCounter
			local isLeft = (col == 1)
			local index = (row - 1) * 2 + col

			local title = makeSectionPanel("Sec" .. s .. "Tab" .. myId .. "Title", content, row,
				SEC_T_SIZE,
				isLeft and SEC_T1_POS or SEC_T2_POS,
				SEC_CORNER_T, TAB_TITLE_PREFIX .. myId)

			local titleOutline = makeTabOutline("Sec" .. s .. "Tab" .. myId .. "TitleOutline", content, row,
				SEC_T_SIZE,
				isLeft and SEC_T1_POS or SEC_T2_POS,
				SEC_CORNER_T, Z_OTHER)

			addTitleIcon(title, tabIconId(s, index))

			local bodyPanel = makeSectionPanel("Sec" .. s .. "Tab" .. myId, content, row,
				isLeft and SEC_P1_SIZE or SEC_P2_SIZE,
				isLeft and SEC_P1_POS or SEC_P2_POS,
				SEC_CORNER_B)

			local bodyOutline = makeTabOutline("Sec" .. s .. "Tab" .. myId .. "Outline", content, row,
				isLeft and SEC_P1_SIZE or SEC_P2_SIZE,
				isLeft and SEC_P1_POS or SEC_P2_POS,
				SEC_CORNER_B)

			local decor = addTabDecor("Sec" .. s .. "Tab" .. myId .. "ToggleIcon", content, row, isLeft)
			decor.Rotation = 0

			local vline = addTabVLine("Sec" .. s .. "Tab" .. myId .. "VLine", content, row, isLeft)

			local baseBodyY  = (isLeft and SEC_P1_POS.Y.Scale or SEC_P2_POS.Y.Scale) + (row - 1) * ROW_STEP
			local baseTitleY = (isLeft and SEC_T1_POS.Y.Scale or SEC_T2_POS.Y.Scale) + (row - 1) * ROW_STEP
			local baseDecorY = (isLeft and TAB_DECOR_POS_LEFT.Y.Scale or TAB_DECOR_POS_RIGHT.Y.Scale) + (row - 1) * ROW_STEP
			local baseVlineY = (isLeft and TAB_VLINE_POS_LEFT.Y.Scale or TAB_VLINE_POS_RIGHT.Y.Scale) + (row - 1) * ROW_STEP

			local tabInfo = {
				body = bodyPanel, bodyOutline = bodyOutline,
				title = title, titleOutline = titleOutline,
				decor = decor, vline = vline,
				baseBodyY = baseBodyY, baseTitleY = baseTitleY,
				baseDecorY = baseDecorY, baseVlineY = baseVlineY,
				closed = false,
			}
			columns[col][row] = tabInfo

			decor.Activated:Connect(function()
				tabInfo.closed = not tabInfo.closed
				tabInfo.body.Visible = not tabInfo.closed
				tabInfo.bodyOutline.Visible = not tabInfo.closed
				tabInfo.decor.Rotation = tabInfo.closed and TAB_TOGGLE_ROTATION_CLOSED or 0
				relayoutColumn(col)
			end)
		end
	end
end
