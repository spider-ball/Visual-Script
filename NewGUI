local sections   = {}   -- [i] = ScrollingFrame раздела i
local topButtons = {}
local currentTab = nil

local function openTab(i)
	if not sections[i] or currentTab == i then return end

	if currentTab then sections[currentTab].Visible = false end
	sections[i].Visible = true
	currentTab = i

	for n, btn in ipairs(topButtons) do
		btn.BackgroundColor3 = (n == i) and BUTTON_ACTIVE_COLOR or BUTTON_COLOR
	end
end

