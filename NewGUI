local function makeGroup(name, zIndex)
	local g = Instance.new("Frame")
	g.Name = name
	g.AnchorPoint = Vector2.new(0.5, 0.5)
	g.Position = UDim2.new(0.5, 0, 0.5, 0)
	g.Size = UDim2.new(1, 0, 1, 0)
	g.BackgroundTransparency = 1
	g.BorderSizePixel = 0
	g.ZIndex = zIndex
	g.Parent = screenGui
	return g
end

local function makeLine(name, parent, isHorizontal, length, position, zIndex)
	local line = Instance.new("Frame")
	line.Name = name
	if isHorizontal then
		line.Size = UDim2.new(length, 0, 0, LINE_THICKNESS)
	else
		line.Size = UDim2.new(0, LINE_THICKNESS, length, 0)
	end
	line.Position = position
	line.AnchorPoint = Vector2.new(0.5, 0.5)
	line.BackgroundColor3 = COLOR_LINES
	line.BorderSizePixel = 0
	line.ZIndex = zIndex
	line.Parent = parent
	return line
end

----------------------------------------------------------------
-- TEXT SCALING SYSTEM
----------------------------------------------------------------
local textObjects = {}

local function registerText(obj, baseSize)
	obj.TextScaled = false
	obj.TextSize = baseSize * BASE_SCALE
	table.insert(textObjects, { obj = obj, base = baseSize })
	return obj
end

local function refreshTextScale(menuSize)
	for _, entry in ipairs(textObjects) do
		entry.obj.TextSize = entry.base * BASE_SCALE * menuSize
	end
end

