local scrollSections = {}

local function syncScroll()
	local w = mainGroup.AbsoluteSize.X
	local h = mainGroup.AbsoluteSize.Y
	for _, e in ipairs(scrollSections) do
		e.content.Size = UDim2.fromOffset(w, h)
		e.content.Position = UDim2.fromOffset(-SCROLL_LEFT * w, -SCROLL_TOP * h)
		e.sf.CanvasSize = UDim2.fromOffset(0, ((ROWS - 1) * ROW_STEP + SCROLL_H) * h)
	end
end
mainGroup:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncScroll)

local function makeSectionScroll(name)
	local sf = Instance.new("ScrollingFrame")
	sf.Name = name
	sf.AnchorPoint = Vector2.new(0.5, 0.5)
	sf.Size = UDim2.new(SCROLL_W, 0, SCROLL_H, 0)
	sf.Position = UDim2.new(SCROLL_LEFT + SCROLL_W / 2, 0, SCROLL_TOP + SCROLL_H / 2, 0)
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollingDirection = Enum.ScrollingDirection.Y
	sf.ScrollBarThickness = SCROLL_BAR_THICK
	sf.ZIndex = Z_OTHER
	sf.Visible = false
	sf.Parent = mainGroup

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ZIndex = Z_OTHER
	content.Parent = sf

	table.insert(scrollSections, { sf = sf, content = content })
	return sf, content
end

local function makeSectionPanel(name, parent, row, size, pos, corner, text)
	local p = makePart(name, parent, size,
		UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale + (row - 1) * ROW_STEP, pos.Y.Offset),
		SEC_COLOR)

	local c = Instance.new("UICorner")
	c.CornerRadius = corner
	c.Parent = p

	if text then
		local lbl = Instance.new("TextLabel")
		lbl.Name = "Label"
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = text
		lbl.Font = Enum.Font.GothamBold
		lbl.TextColor3 = Color3.fromRGB(0, 0, 0)
		lbl.ZIndex = Z_OTHER
		lbl.Parent = p
		registerText(lbl, TEXT_BASE_LABEL)
	end

	return p
end

