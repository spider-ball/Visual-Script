local SEC_T2_POS    = UDim2.new(0.71, 0, 0.26, 0)

local SEC_COLOR     = Color3.fromRGB(100, 100, 100)
local SEC_ANCHOR    = Vector2.new(0.5, 0.5)
local SEC_TRANS     = 0
local SEC_CORNER_B  = UDim.new(0.05, 5)
local SEC_CORNER_T  = UDim.new(0.05, 15)

local function makeSectionPanel(name, size, pos, corner, text)
	local p = Instance.new("Frame")
	p.Name = name
	p.Size = size
	p.Position = pos
	p.AnchorPoint = SEC_ANCHOR
	p.BackgroundColor3 = SEC_COLOR
	p.BackgroundTransparency = SEC_TRANS
	p.BorderSizePixel = 0
	p.ZIndex = Z_OTHER
	p.Visible = false
	p.Parent = mainGroup

	local c = Instance.new("UICorner")
	c.CornerRadius = corner
	c.Parent = p

	if text then
		local lbl = Instance.new("TextLabel")
		lbl.Name = "Label"
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = text
		lbl.Font = Enum.Font.GothamBold
		lbl.TextColor3 = Color3.fromRGB(0, 0, 0)
		lbl.ZIndex = Z_OTHER
		lbl.Parent = p

		registerText(lbl, TEXT_BASE_LABEL)
	end

	return p
end

local tabCounter = 0
for s = 1, BUTTON_COUNT do
	tabPanels[s] = {}

	table.insert(tabPanels[s],
		makeSectionPanel("Sec"..s.."Panel1", SEC_P1_SIZE, SEC_P1_POS, SEC_CORNER_B))

	table.insert(tabPanels[s],
		makeSectionPanel("Sec"..s.."Panel2", SEC_P2_SIZE, SEC_P2_POS, SEC_CORNER_B))

	tabCounter = tabCounter + 1
	table.insert(tabPanels[s],
		makeSectionPanel("Sec"..s.."Tab1", SEC_T_SIZE, SEC_T1_POS, SEC_CORNER_T, "Вкладка " .. tabCounter))

	tabCounter = tabCounter + 1
	table.insert(tabPanels[s],
		makeSectionPanel("Sec"..s.."Tab2", SEC_T_SIZE, SEC_T2_POS, SEC_CORNER_T, "Вкладка " .. tabCounter))
end

