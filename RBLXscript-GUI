local MAGENTA = Color3.fromRGB(255, 0, 255)
local HEADER_H = 44
local CARD_H = 200 -- fixed card height (px)
local CARD_ROWS = 3 -- cards per column on every page (more than fits = scrolling)
local CARD_FULL = UDim2.new(1, 0, 0, CARD_H)
local CARD_COLLAPSED = UDim2.new(1, 0, 0, HEADER_H)
local TweenService = game:GetService("TweenService")

-- One card = header (icon + title + collapse button) joined with its own body.
-- ClipsDescendants + UICorner round only the outer corners, header/body junction stays square.
local function createCard(parent, titleText, iconText, order)
	local card = Instance.new("Frame")
	card.Name = "Card"
	card.Size = CARD_FULL
	card.LayoutOrder = order
	card.BackgroundColor3 = MAGENTA
	card.BorderSizePixel = 0
	card.ClipsDescendants = true
	card.ZIndex = 5
	card.Parent = parent
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 18)
	local cs = Instance.new("UIStroke", card)
	cs.Color = Color3.fromRGB(0, 0, 0)
	cs.Thickness = 2

	local iconBox = Instance.new("TextLabel")
	iconBox.Name = "CardIcon"
	iconBox.Size = UDim2.new(0, 36, 0, 36)
	iconBox.Position = UDim2.new(0, 6, 0, 4)
	iconBox.BackgroundColor3 = Color3.fromRGB(255, 50, 0)
	iconBox.BorderSizePixel = 0
	iconBox.Text = iconText
	iconBox.TextColor3 = Color3.fromRGB(0, 0, 0)
	iconBox.Font = Enum.Font.GothamBold
	iconBox.TextScaled = true
	iconBox.ZIndex = 7
	iconBox.Parent = card
	Instance.new("UICorner", iconBox).CornerRadius = UDim.new(0, 10)

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "CardTitle"
	titleLabel.Size = UDim2.new(1, -(HEADER_H + 4 + 44), 0, HEADER_H)
	titleLabel.Position = UDim2.new(0, HEADER_H + 4, 0, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = titleText
	titleLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextSize = 18
	titleLabel.ZIndex = 7
	titleLabel.Parent = card

	-- line between header and body
	local line = Instance.new("Frame")
	line.Name = "HeaderLine"
	line.Size = UDim2.new(1, 0, 0, 2)
	line.Position = UDim2.new(0, 0, 0, HEADER_H)
	line.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	line.BorderSizePixel = 0
	line.ZIndex = 6
	line.Parent = card

	-- collapse / expand button (top right corner of the header)
	local collapseBtn = Instance.new("TextButton")
	collapseBtn.Name = "CollapseButton"
	collapseBtn.Size = UDim2.new(0, 28, 0, 28)
	collapseBtn.AnchorPoint = Vector2.new(1, 0)
	collapseBtn.Position = UDim2.new(1, -8, 0, 8)
	collapseBtn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	collapseBtn.BorderSizePixel = 0
	collapseBtn.Text = "-"
	collapseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	collapseBtn.Font = Enum.Font.GothamBold
	collapseBtn.TextSize = 22
	collapseBtn.AutoButtonColor = false
	collapseBtn.ZIndex = 8
	collapseBtn.Parent = card
	Instance.new("UICorner", collapseBtn).CornerRadius = UDim.new(0, 8)

	local collapsed = false
	collapseBtn.MouseButton1Click:Connect(function()
		collapsed = not collapsed
		collapseBtn.Text = collapsed and "+" or "-"
		line.Visible = not collapsed
		TweenService:Create(card, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = collapsed and CARD_COLLAPSED or CARD_FULL
		}):Play()
	end)

	return card
end

local pages = {}
for i = 1, 10 do
	-- page = scrollable area (starts right below the top panel)
	local page = Instance.new("ScrollingFrame")
	page.Name = "Page" .. i
	page.Size = UDim2.new(1, 0, 1, -26)
	page.Position = UDim2.new(0, 0, 0, 26)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollingDirection = Enum.ScrollingDirection.Y
	page.ScrollBarThickness = 4
	page.ScrollBarImageColor3 = Color3.fromRGB(0, 0, 0)
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.Visible = false
	page.ZIndex = 4
	page.Parent = pagesFolder

	-- two columns, cards are stacked vertically inside each column
	local function createColumn(xScale, iconText)
		local column = Instance.new("Frame")
		column.Name = "Column"
		column.Size = UDim2.new(0.44, 0, 0, 0)
		column.Position = UDim2.new(xScale, 0, 0, 8)
		column.AutomaticSize = Enum.AutomaticSize.Y
		column.BackgroundTransparency = 1
		column.Parent = page

		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 12)
		layout.Parent = column

		local pad = Instance.new("UIPadding")
		pad.PaddingBottom = UDim.new(0, 16)
		pad.Parent = column

		for row = 1, CARD_ROWS do
			createCard(column, "Title 1", iconText, row)
		end
	end

	createColumn(0.04, "Icon\n4")
	createColumn(0.52, "Icon\n5")

	pages[i] = page
end

-- Section 1..10 are topButtons[2]..topButtons[11] (Icon 1 / Icon 2 are not sections)
local sectionButtons = {}
for i = 1, 10 do
	sectionButtons[i] = topButtons[i + 1]
end

local function openSection(index)
	for i, page in ipairs(pages) do
		local active = (i == index)
		page.Visible = active
		local b = sectionButtons[i]
		b.BackgroundColor3 = Color3.fromRGB(140, 25, 25)
		b.BackgroundTransparency = active and 0 or 1
		-- selected section: sharp corners, others: rounded
		local c = b:FindFirstChildOfClass("UICorner")
		if c then
			c.CornerRadius = active and UDim.new(0, 0) or UDim.new(0, 6)
		end
	end
end

for i, btn in ipairs(sectionButtons) do
	btn.MouseButton1Click:Connect(function()
		openSection(i)
	end)
end

