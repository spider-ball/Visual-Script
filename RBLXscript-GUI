	fovValueBox.FocusLost:Connect(function()
		local num = tonumber(fovValueBox.Text)
		if num then setFov(num) else fovValueBox.Text = tostring(math.floor(currentFov + 0.5)) end
		saveSettingsDelayed()
	end)

	local dragging, dragInput = false, nil
	local function updateFromPos(inputPosition)
		local trackSize = track.AbsoluteSize.X
		if trackSize <= 0 then return end
		local relative = math.clamp((inputPosition.X - track.AbsolutePosition.X) / trackSize, 0, 1)
		setFov(FOV_MIN + relative * (FOV_MAX - FOV_MIN))
	end
	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragInput = input
			updateFromPos(input.Position)
			local connection
			connection = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false; dragInput = nil
					connection:Disconnect(); saveSettingsDelayed()
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then updateFromPos(input.Position) end
	end)
end

