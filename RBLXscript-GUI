-- Divider is added only if addDivider = true (not after the last button),
-- its thickness = DIVIDER_WIDTH, same as greyBlueDivider, and it fully fills
-- the gap between buttons (Padding is also DIVIDER_WIDTH)
local function createRedPanel(text, addDivider, extraWidth)
	local panel = Instance.new("TextButton")
	panel.Size = UDim2.new(1/12, -4 + (extraWidth or 0), 1, 0)
	panel.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	panel.BackgroundTransparency = 1 -- red fill comes from the top panel (greenTop)
	panel.BorderSizePixel = 0
	panel.Text = text
	panel.TextColor3 = Color3.fromRGB(255, 255, 255)
	panel.Font = Enum.Font.GothamBold
	panel.TextScaled = true
	panel.ZIndex = 10
	panel.ClipsDescendants = false
	panel.Parent = buttonsContainer

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 6)
	panelCorner.Parent = panel

	if addDivider then
		local separator = Instance.new("Frame")
		separator.Name = "Divider"
		-- panel spans 0..48px; divider goes from -4 (clipped by menuContainer)
		-- to 52px (bottom of the top panel)
		separator.Size = UDim2.new(0, DIVIDER_WIDTH, 1, 8)
		separator.Position = UDim2.new(1, 0, 0, -4)
		separator.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		separator.BorderSizePixel = 0
		separator.ZIndex = 11
		separator.Parent = panel
	end

	return panel
end

