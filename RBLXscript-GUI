-- Section 1 - Card 1: Skies
local function populateSkiesCard(body)
	for i, d in ipairs(SKY_LIST) do
		local b = createListButton(body, d[2], i)
		skyButtons[i] = b
		skyButtonByKey[d[1]] = b
		b.MouseButton1Click:Connect(function()
			local tex = SKY_TEXTURES[d[1]]
			if tex then
				applyCustomSky(d[1], tex, b)
			else
				applyDefaultSky()
			end
			saveSettingsDelayed()
		end)
	end
	setActiveSkyButton(skyButtonByKey["DefaultSky"])
end

-- Section 1 - Card 2: Effects
local function populateEffectsCard(body)
	for i, data in ipairs(visualPresets) do
		local b = createListButton(body, data[2], i)
		visualButtons[data[1]] = b
		b.MouseButton1Click:Connect(function()
			applyVisualPreset(data[1])
			for name, button in pairs(visualButtons) do
				local isActive = (name == data[1])
				button.BackgroundColor3 = isActive and Color3.fromRGB(252, 207, 242) or BTN_COLOR
				button.TextColor3 = isActive and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
			end
			saveSettingsDelayed()
		end)
	end
	local removeBtn = createListButton(body, "Remove All Effects", #visualPresets + 1)
	removeBtn.MouseButton1Click:Connect(function()
		clearVisualPreset()
		resetLightingToOriginal()
		for name, button in pairs(visualButtons) do
			local isActive = (name == "None")
			button.BackgroundColor3 = isActive and Color3.fromRGB(252, 207, 242) or BTN_COLOR
			button.TextColor3 = isActive and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
		end
		removeBtn.Text = "Effects Removed"
		task.delay(1.5, function()
			if removeBtn.Parent then
				removeBtn.Text = "Remove All Effects"
			end
		end)
		saveSettingsDelayed()
	end)
	for name, button in pairs(visualButtons) do
		local isActive = (name == "None")
		button.BackgroundColor3 = isActive and Color3.fromRGB(252, 207, 242) or BTN_COLOR
		button.TextColor3 = isActive and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
	end
end

