-- Divider добавляется только если addDivider = true (не после последней кнопки),
-- толщина = DIVIDER_WIDTH, как и у greyBlueDivider, и полностью заполняет
-- промежуток между кнопками (Padding тоже = DIVIDER_WIDTH)
local function createRedPanel(text, addDivider, extraWidth)
	local panel = Instance.new("TextButton")
	panel.Size = UDim2.new(1/12, -4 + (extraWidth or 0), 1, 0)
	panel.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	panel.BackgroundTransparency = 1 -- красная заливка берётся из верхней панели (greenTop)
	panel.BorderSizePixel = 0
	panel.Text = text
	panel.TextColor3 = Color3.fromRGB(255, 255, 255)
	panel.Font = Enum.Font.GothamBold
	panel.TextScaled = true
	panel.ZIndex = 10
	panel.ClipsDescendants = false
	panel.Parent = buttonsContainer

	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 6)
	panelCorner.Parent = panel

	if addDivider then
		local separator = Instance.new("Frame")
		separator.Name = "Divider"
		-- панель занимает 0..48px; разделитель идёт от -4 (обрезается menuContainer)
		-- до 52px (низ верхней панели)
		separator.Size = UDim2.new(0, DIVIDER_WIDTH, 1, 8)
		separator.Position = UDim2.new(1, 0, 0, -4)
		separator.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		separator.BorderSizePixel = 0
		separator.ZIndex = 11
		separator.Parent = panel
	end
end

-- Русские строки. Если экзекьютор выдаёт кракозябры,
-- можно заменить их обратно на \u-эскейпы.
local IKONKA = "Иконка"
local RAZDEL = "Раздел"

local panelNames = {
	IKONKA .. "\n1",
	RAZDEL .. "\n1", RAZDEL .. "\n2", RAZDEL .. "\n3", RAZDEL .. "\n4", RAZDEL .. "\n5",
	RAZDEL .. "\n6", RAZDEL .. "\n7", RAZDEL .. "\n8", RAZDEL .. "\n9", RAZDEL .. "\n10",
	IKONKA .. "\n2"
}

for i, name in ipairs(panelNames) do
	createRedPanel(name, i < #panelNames, (i == 1 or i == #panelNames) and EDGE_EXTRA or MID_EXTRA)
end

