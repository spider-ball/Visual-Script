-- dragging on the square / hue slider
-- input.Position can differ from GUI coordinates by the GUI inset (vertical offset). The offset is
-- learned from a press that can only match one variant; until it is known the marker moves
-- relatively (by finger movement) so it never jumps away.
local inputOffsetY = nil

local function bindPickerDrag(hit, frame, getFrac, onFrac)
	local dragging, dragInput = false, nil
	local startRaw, startFrac, absMode = nil, nil, false

	local function update(pos)
		local size = frame.AbsoluteSize
		if size.X <= 0 or size.Y <= 0 then return end
		local fx, fy
		if absMode then
			fx = (pos.X - frame.AbsolutePosition.X) / size.X
			fy = (pos.Y + inputOffsetY - frame.AbsolutePosition.Y) / size.Y
		else
			fx = startFrac.X + (pos.X - startRaw.X) / size.X
			fy = startFrac.Y + (pos.Y - startRaw.Y) / size.Y
		end
		onFrac(math.clamp(fx, 0, 1), math.clamp(fy, 0, 1))
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		dragInput = input
		startRaw = Vector2.new(input.Position.X, input.Position.Y)

		if inputOffsetY == nil then
			local inset = GuiService:GetGuiInset().Y
			if inset == 0 then
				inputOffsetY = 0
			else
				local top = frame.AbsolutePosition.Y
				local bottom = top + frame.AbsoluteSize.Y
				local in0 = startRaw.Y >= top and startRaw.Y <= bottom
				local in1 = startRaw.Y + inset >= top and startRaw.Y + inset <= bottom
				if in0 and not in1 then
					inputOffsetY = 0
				elseif in1 and not in0 then
					inputOffsetY = inset
				end
			end
		end

		absMode = (inputOffsetY ~= nil)
		startFrac = Vector2.new(getFrac())
		if absMode then
			update(input.Position)
		end

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end)

	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or (input.UserInputType == Enum.UserInputType.Touch and input == dragInput)
		if not isMove then return end
		update(input.Position)
	end))
end

