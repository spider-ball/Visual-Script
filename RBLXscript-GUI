-- Sync grey/blue divider with the real right edge of the first top button
local firstTopButton = buttonsContainer:FindFirstChildWhichIsA("TextButton")
local firstTopDivider = firstTopButton:WaitForChild("Divider")

local function syncDivider()
	local x = firstTopDivider.AbsolutePosition.X - greyPanel.AbsolutePosition.X
	greyBlueDivider.Position = UDim2.new(0, x, 0, 0)
	bluePanel.Position = UDim2.new(0, x + DIVIDER_WIDTH / 2, 0, 0)
	bluePanel.Size = UDim2.new(1, -(x + DIVIDER_WIDTH / 2), 1, 0)
end

firstTopDivider:GetPropertyChangedSignal("AbsolutePosition"):Connect(syncDivider)
firstTopDivider:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncDivider)
greyPanel:GetPropertyChangedSignal("AbsolutePosition"):Connect(syncDivider)
task.defer(syncDivider)

