-- buttonsContainer (создан ниже) имеет отступы Position(0,5,0,6) и Size(1,-10,0,40).
-- Чтобы граница серой/синей панели совпадала с границей "Иконка1"/"Раздел1",
-- нужен тот же отступ: 5 - 10/12
-- Ширины ячеек верхнего ряда: крайние ячейки ("Иконка 1" / "Иконка 2") получают EDGE_EXTRA px
-- сверх базовой ширины, средние получают MID_EXTRA px, чтобы весь ряд всё ещё равнялся ширине меню
-- (2*EDGE + 10*MID = 14).
local EDGE_EXTRA = 0
local MID_EXTRA = (14 - 2 * EDGE_EXTRA) / 10
local COLUMN_OFFSET = EDGE_EXTRA - 2 - 10/12

