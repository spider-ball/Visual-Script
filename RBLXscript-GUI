local function setActiveSkyButton(activeButton)
	for _, button in ipairs(skyButtons) do
		local isActive = (button == activeButton)
		button.BackgroundColor3 = isActive and Color3.fromRGB(252, 207, 242) or BTN_COLOR
		button.TextColor3 = isActive and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
	end
end

local function clearCustomSky()
	if customSky then
		customSky:Destroy()
		customSky = nil
	end
	cleanupCustomSky()
end

local function applyDefaultSky()
	clearCustomSky()
	if originalSky and not originalSky.Parent then originalSky.Parent = Lighting end
	setActiveSkyButton(skyButtonByKey["DefaultSky"])
	currentSkyName = "DefaultSky"
end

local function applyCustomSky(name, textures, button)
	clearCustomSky()
	if originalSky then originalSky.Parent = nil end
	customSky = Instance.new("Sky")
	customSky.Name = "FTAP_CustomSky"
	customSky.SkyboxFt = textures.Front
	customSky.SkyboxRt = textures.Right
	customSky.SkyboxBk = textures.Back
	customSky.SkyboxUp = textures.Up
	customSky.SkyboxLf = textures.Left
	customSky.SkyboxDn = textures.Down
	customSky.Parent = Lighting
	setActiveSkyButton(button)
	currentSkyName = name
end

-- Visual state
local VISUAL_PRESET_TAG = "FTAP_VisualPreset"
local ORIGINAL_LIGHTING = {
	ClockTime = Lighting.ClockTime,
	Brightness = Lighting.Brightness,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
	ColorShift_Top = Lighting.ColorShift_Top,
	ColorShift_Bottom = Lighting.ColorShift_Bottom,
	ShadowSoftness = Lighting.ShadowSoftness,
	GeographicLatitude = Lighting.GeographicLatitude,
	EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
	EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
}
local function clearVisualPreset()
	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:GetAttribute(VISUAL_PRESET_TAG) == true then
			obj:Destroy()
		end
	end
	for _, obj in ipairs(Lighting:GetChildren()) do
		if obj:IsA("Atmosphere")
			or obj:IsA("BloomEffect")
			or obj:IsA("ColorCorrectionEffect")
			or obj:IsA("SunRaysEffect")
			or obj:IsA("BlurEffect")
			or obj:IsA("DepthOfFieldEffect") then
			obj:Destroy()
		end
	end
end
local function resetLightingToOriginal()
	Lighting.ClockTime = ORIGINAL_LIGHTING.ClockTime
	Lighting.Brightness = ORIGINAL_LIGHTING.Brightness
	Lighting.Ambient = ORIGINAL_LIGHTING.Ambient
	Lighting.OutdoorAmbient = ORIGINAL_LIGHTING.OutdoorAmbient
	Lighting.ColorShift_Top = ORIGINAL_LIGHTING.ColorShift_Top
	Lighting.ColorShift_Bottom = ORIGINAL_LIGHTING.ColorShift_Bottom
	Lighting.ShadowSoftness = ORIGINAL_LIGHTING.ShadowSoftness
	Lighting.GeographicLatitude = ORIGINAL_LIGHTING.GeographicLatitude
	Lighting.EnvironmentDiffuseScale = ORIGINAL_LIGHTING.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = ORIGINAL_LIGHTING.EnvironmentSpecularScale
end
local function newVisual(className, name)
	local obj = Instance.new(className)
	obj.Name = name
	obj:SetAttribute(VISUAL_PRESET_TAG, true)
	obj.Parent = Lighting
	return obj
end
local function applyVisualPreset(preset)
	clearVisualPreset()
	resetLightingToOriginal()
	if preset == "None" then
