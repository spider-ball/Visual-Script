-- ---------- save ----------
local function saveSettings()
	if type(writefile) ~= "function" then return end
	local data = { colors = {}, outlineThickness = outlineThickness, font = currentFont }
	for name, c in pairs(colors) do
		local r, g, b = to255(c)
		data.colors[name] = { r, g, b }
	end
	local ok, err = pcall(function()
		writefile(SETTINGS_FILE, HttpService:JSONEncode(data))
	end)
	if not ok then warn("[GUI] Save error:", err) end
end

local function saveSettingsDelayed()
	if saveDebounce then return end
	saveDebounce = true
	task.delay(0.5, function()
		saveDebounce = false
		saveSettings()
	end)
end

-- ---------- text color (all text except popups) ----------
local function applyTextColor(c)
	for _, inst in ipairs(screenGui:GetDescendants()) do
		if (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox"))
			and not inst:IsDescendantOf(paletteFrame)
			and not inst:IsDescendantOf(fontListFrame) then
			inst.TextColor3 = c
		end
	end
end

-- ---------- partitions ----------
local function setPartitionThickness(w)
	for _, e in ipairs(partitionLines) do
		sizeLine(e[1], w, e[2])
	end
end

-- ---------- outline thickness ----------
local function setOutlineThickness(t)
	t = tonumber(string.format("%.1f", math.clamp(t, 0, 8))) -- 0.1 precision
	outlineThickness = t
	setPartitionThickness(t * 2) -- partitions follow the thickness (t = 2 -> width 4, as before)
	for _, e in ipairs(outlineStrokes) do
		e[1].Thickness = t + e[2]
	end
	for _, line in ipairs(outlineLines) do
		sizeLine(line, t, false)
	end
	for n, sw in pairs(swatchButtons) do
		sw:FindFirstChildOfClass("UIStroke").Thickness = (n == selectedSwatch) and (t + 1) or t
	end
	if thicknessBox then thicknessBox.Text = tostring(t) end
	
	-- FIX: Sync layout elements to prevent shifting when thickness changes
	syncDivider()
	updateSelector()
end

-- user = true when the color was changed by the player
local function applyColor(name, c, user)
	colors[name] = c
	for _, inst in ipairs(colorTargets[name]) do
		inst.BackgroundColor3 = c
	end
	local sw = swatchButtons[name]
	if sw then sw.BackgroundColor3 = c end
	if name == "main" then
		activeSectionColor = c:Lerp(Color3.new(0, 0, 0), 0.35)
		sectionSelector.BackgroundColor3 = activeSectionColor
	elseif name == "text" then
		applyTextColor(c)
	elseif name == "outline" then
		for _, f in ipairs(outlineFrames) do
			f.BackgroundColor3 = c
		end
		for _, e in ipairs(outlineStrokes) do
			e[1].Color = c
		end
		for n, swb in pairs(swatchButtons) do
			if n ~= selectedSwatch then
				swb:FindFirstChildOfClass("UIStroke").Color = c
			end
		end
	end
end

