-- ==========================================
-- 10. LOAD SAVED SETTINGS
-- ==========================================
local function loadSettings()
	if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
	if not isfile(SETTINGS_FILE) then return end
	local ok, raw = pcall(readfile, SETTINGS_FILE)
	if not ok or not raw then return end
	local ok2, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok2 or type(data) ~= "table" then return end

	if type(data.colors) == "table" then
		for name, v in pairs(data.colors) do
			if DEFAULT_COLORS[name] and type(v) == "table" and tonumber(v[1]) and tonumber(v[2]) and tonumber(v[3]) then
				local c = Color3.fromRGB(
					math.clamp(v[1], 0, 255),
					math.clamp(v[2], 0, 255),
					math.clamp(v[3], 0, 255)
				)
				hsv[name] = { c:ToHSV() }
				applyColor(name, c, true)
			end
		end
	end
	if tonumber(data.outlineThickness) then
		setOutlineThickness(data.outlineThickness)
	end
	if type(data.font) == "string" and table.find(FONT_OPTIONS, data.font) then
		setFont(data.font)
	end
	updatePickerUI()
end

loadSettings()
