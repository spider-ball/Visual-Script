function saveSettings()
	local activeVisual = "None"
	for name, button in pairs(visualButtons) do
		if button.BackgroundColor3 == Color3.fromRGB(252, 207, 242) then
			activeVisual = name
			break
		end
	end
	local data = {
		sky = currentSkyName,
		visual = activeVisual,
		fov = math.floor(currentFov),
	}
	local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
	if not ok then return end
	writeFile(SETTINGS_FILE, encoded)
end

saveSettingsDelayed = function()
	if saveDebounce then return end
	saveDebounce = true
	task.delay(0.5, function()
		saveDebounce = false
		saveSettings()
	end)
end

local function applyLoadedSettings(data)
	if type(data) ~= "table" then return end
	if data.fov and _G.__GUI_setFov then _G.__GUI_setFov(data.fov) end
	if data.sky and data.sky ~= "DefaultSky" then
		local tex = SKY_TEXTURES[data.sky]
		if tex then
			applyCustomSky(data.sky, tex, skyButtonByKey[data.sky])
		else
			applyDefaultSky()
		end
	else
		applyDefaultSky()
	end
	if data.visual then
		applyVisualPreset(data.visual)
		for name, button in pairs(visualButtons) do
			local isActive = (name == data.visual)
			button.BackgroundColor3 = isActive and Color3.fromRGB(252, 207, 242) or BTN_COLOR
			button.TextColor3 = isActive and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
		end
	end
end

local function loadSettings()
	if not fileExists(SETTINGS_FILE) then return end
	local raw = readFile(SETTINGS_FILE)
	if not raw then return end
	local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(data) ~= "table" then return end
	applyLoadedSettings(data)
end

loadSettings()
