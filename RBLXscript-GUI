local isMenuOpen = true
local DRAG_THRESHOLD = 3
local connections = {}
local DEFAULT_MENU_POS = menuContainer.Position
local DEFAULT_TOGGLE_POS = toggleButton.Position

local function makeDraggable(handle, target)
	local dragging, dragInput, dragStart, startPos, startAbs = false, nil, nil, nil, nil
	local moved = false

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		dragging = true
		moved = false
		dragInput = input
		dragStart = input.Position
		startPos = target.Position
		startAbs = target.AbsolutePosition
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end)

	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
			or (input.UserInputType == Enum.UserInputType.Touch and input == dragInput)
		if not isMove then return end

		local delta = input.Position - dragStart
		if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
			moved = true
		end
		if not moved then return end

		local origin = screenGui.AbsolutePosition
		local vp = screenGui.AbsoluteSize
		local size = target.AbsoluteSize
		local dx = math.clamp(delta.X, origin.X - startAbs.X, origin.X + vp.X - size.X - startAbs.X)
		local dy = math.clamp(delta.Y, origin.Y - startAbs.Y, origin.Y + vp.Y - size.Y - startAbs.Y)

		target.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + dx,
			startPos.Y.Scale, startPos.Y.Offset + dy
		)
	end))

	return function() return moved end
end

