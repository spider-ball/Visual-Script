-- UDim offsets are whole pixels, so a fractional thickness is drawn as ceil(w) pixels with
-- matching transparency (0.5 -> 1 px at 50%, 2.5 -> 3 px at 83%)
local function sizeLine(line, w, vertical)
	local px = math.ceil(w - 1e-6)
	local alpha = (px > 0) and (w / px) or 0
	line.BackgroundTransparency = 1 - alpha
	line.Size = vertical and UDim2.new(0, px, 1, 0) or UDim2.new(1, 0, 0, px)
end

-- A partition keeps its layout slot (4 px) but is drawn by a separate centered line,
-- so changing the thickness never moves any element.
local function makePartition(parentFrame, vertical)
	parentFrame.BackgroundTransparency = 1
	local line = Instance.new("Frame")
	line.Name = "OutlineLine"
	line.BorderSizePixel = 0
	line.BackgroundColor3 = colors.outline
	line.ZIndex = parentFrame.ZIndex
	if vertical then
		line.AnchorPoint = Vector2.new(0.5, 0)
		line.Position = UDim2.new(0.5, 0, 0, 0)
		line.Size = UDim2.new(0, 4, 1, 0)
	else
		line.AnchorPoint = Vector2.new(0, 1) -- flush with the bottom edge of the bar
		line.Position = UDim2.new(0, 0, 1, 0)
		line.Size = UDim2.new(1, 0, 0, 4)
	end
	line.Parent = parentFrame
	table.insert(partitionLines, { line, vertical })
	table.insert(outlineFrames, line)
end

