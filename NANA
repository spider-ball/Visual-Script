-- (Пропущены для краткости, если нужен полный код - скажи, я пришлю)

local function createCard(parent, titleText, iconText, order, bodyHeight)
	bodyHeight = bodyHeight or 200
	local expandedSize = UDim2.new(1, 0, 0, HEADER_H + bodyHeight)
	local collapsedSize = UDim2.new(1, 0, 0, HEADER_H)
	local card = Instance.new("Frame")
	card.Size = expandedSize
	card.LayoutOrder = order
	card.BackgroundColor3 = CARD_BODY_COLOR
	card.BorderSizePixel = 0
	card.ClipsDescendants = true
	card.ZIndex = 5
	card.Parent = parent
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 18)
	local cs = Instance.new("UIStroke", card) cs.Color = Color3.fromRGB(0,0,0) cs.Thickness = 2
	local headerBg = Instance.new("Frame")
	headerBg.Size = UDim2.new(1,0,0,HEADER_H)
	headerBg.BackgroundColor3 = CARD_HEADER_COLOR
	headerBg.BorderSizePixel = 0
	headerBg.ZIndex = 5
	headerBg.Parent = card
	Instance.new("UICorner", headerBg).CornerRadius = UDim.new(0, 18)
	local sq = Instance.new("Frame") sq.Size = UDim2.new(1,0,0,18) sq.Position = UDim2.new(0,0,1,-18) sq.BackgroundColor3 = CARD_HEADER_COLOR sq.BorderSizePixel = 0 sq.ZIndex = 5 sq.Parent = headerBg
	local iconBox = Instance.new("TextLabel")
	iconBox.Size = UDim2.new(0,36,0,36)
	iconBox.Position = UDim2.new(0,6,0,4)
	iconBox.BackgroundColor3 = Color3.fromRGB(255,50,0)
	iconBox.BorderSizePixel = 0
	iconBox.Text = iconText
	iconBox.TextColor3 = Color3.fromRGB(0,0,0)
	iconBox.Font = Enum.Font.GothamBold
	iconBox.TextScaled = true
	iconBox.ZIndex = 7
	iconBox.Parent = card
	Instance.new("UICorner", iconBox).CornerRadius = UDim.new(0, 10)
	local titleL = Instance.new("TextLabel")
	titleL.Size = UDim2.new(1, -(HEADER_H + 48), 0, HEADER_H)
	titleL.Position = UDim2.new(0, HEADER_H + 4, 0, 0)
	titleL.BackgroundTransparency = 1
	titleL.Text = titleText
	titleL.TextColor3 = Color3.fromRGB(255,255,255)
	titleL.Font = Enum.Font.GothamBold
	titleL.TextSize = 18
	titleL.ZIndex = 7
	titleL.Parent = card
	local line = Instance.new("Frame")
	line.Size = UDim2.new(1,0,0,2)
	line.Position = UDim2.new(0,0,0,HEADER_H)
	line.BackgroundColor3 = Color3.fromRGB(0,0,0)
	line.BorderSizePixel = 0
	line.ZIndex = 6
	line.Parent = card
	local cb = Instance.new("TextButton")
	cb.Size = UDim2.new(0,28,0,28)
	cb.AnchorPoint = Vector2.new(1,0)
	cb.Position = UDim2.new(1,-8,0,8)
	cb.BackgroundColor3 = Color3.fromRGB(0,0,0)
	cb.BorderSizePixel = 0
	cb.Text = "-"
	cb.TextColor3 = Color3.fromRGB(255,255,255)
	cb.Font = Enum.Font.GothamBold
	cb.TextSize = 22
	cb.AutoButtonColor = false
	cb.ZIndex = 8
	cb.Parent = card
	Instance.new("UICorner", cb).CornerRadius = UDim.new(0, 8)
	local collapsed = false
	cb.MouseButton1Click:Connect(function()
		collapsed = not collapsed
		cb.Text = collapsed and "+" or "-"
		line.Visible = not collapsed
		TweenService_:Create(card, TweenInfo.new(0.2), {Size = collapsed and collapsedSize or expandedSize}):Play()
	end)
	local body = Instance.new("ScrollingFrame")
	body.Size = UDim2.new(1,0,1,-(HEADER_H+8))
	body.Position = UDim2.new(0,0,0,HEADER_H)
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.ScrollingDirection = Enum.ScrollingDirection.Y
	body.ScrollBarThickness = 4
	body.ScrollBarImageColor3 = Color3.fromRGB(150,150,150)
	body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.CanvasSize = UDim2.new(0,0,0,0)
	body.ZIndex = 7
	body.Parent = card
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 6)
	layout.Parent = body
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0,8); pad.PaddingBottom = UDim.new(0,8); pad.PaddingLeft = UDim.new(0,10); pad.PaddingRight = UDim.new(0,10)
	pad.Parent = body
	return card, body
end
