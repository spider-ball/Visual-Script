		Lighting.ClockTime=0; Lighting.Brightness=1; Lighting.Ambient=Color3.fromRGB(20,25,45); Lighting.OutdoorAmbient=Color3.fromRGB(35,45,80); Lighting.ColorShift_Top=Color3.fromRGB(45,55,110); Lighting.ColorShift_Bottom=Color3.fromRGB(15,20,45)
		local A=newVis("Atmosphere","A") A.Density=0.25 A.Haze=1.2 A.Color=Color3.fromRGB(100,120,180) A.Decay=Color3.fromRGB(35,45,90)
		local C=newVis("ColorCorrectionEffect","C") C.Brightness=-0.04 C.Contrast=0.3 C.Saturation=-0.05 C.TintColor=Color3.fromRGB(180,195,240)
		local B=newVis("BloomEffect","B") B.Intensity=0.35 B.Size=24 B.Threshold=1.1
	end
end

