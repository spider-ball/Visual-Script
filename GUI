local function createRedPanel(text)
	local panel = Instance.new("TextButton")
	panel.Size = UDim2.new(1/12, -4, 0, 34) 
	panel.BackgroundColor3 = Color3.fromRGB(200, 50, 50) 
	panel.BorderSizePixel = 0
	panel.Text = text
	panel.TextColor3 = Color3.fromRGB(255, 255, 255)
	panel.Font = Enum.Font.GothamBold
	panel.TextScaled = true
	panel.ZIndex = 10
	panel.ClipsDescendants = false 
	panel.Parent = buttonsContainer
	
	local panelCorner = Instance.new("UICorner")
	panelCorner.CornerRadius = UDim.new(0, 6) 
	panelCorner.Parent = panel

	local separator = Instance.new("Frame")
	separator.Name = "Divider"
	separator.Size = UDim2.new(0, 2, 1.5, 0) 
	separator.Position = UDim2.new(1, 1, -0.25, 0) 
	separator.BackgroundColor3 = Color3.fromRGB(0, 0, 0) 
	separator.BorderSizePixel = 0
	separator.ZIndex = 11 
	separator.Parent = panel
end

local panelNames = {
	"Иконка\n1", 
	"Раздел\n1", "Раздел\n2", "Раздел\n3", "Раздел\n4", "Раздел\n5", 
