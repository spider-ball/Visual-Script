end

local function getIslandCircleImpulse(pos, strength)
	local dx = pos.X - ISLAND_CENTER.X
	local dz = pos.Z - ISLAND_CENTER.Z
	local pd = math.sqrt(dx*dx + dz*dz)
	if pd < 0.5 then return Vector3.new(0,0,0) end
	local radialDir = Vector3.new(dx / pd, 0, dz / pd)
	local tanDir = Vector3.new(-radialDir.Z, 0, radialDir.X)
	local radialDiff = pd - ISLAND_CIRCLE_RADIUS
	local flow = tanDir * (strength * 0.9)
	local corrMag = 0
	local ABS = math.abs(radialDiff)
	if ABS > ISLAND_DEADZONE then
		local sign = (radialDiff > 0) and -1 or 1
		local over = ABS - ISLAND_DEADZONE
		corrMag = sign * math.min(over * 3, strength * 0.6)
	end
	return flow + radialDir * corrMag
end

local function getWaveImpulse(region, pos, t)
	local kindData = WAVE_KINDS[modeKey] or WAVE_KINDS["Тихое"]
	local dirData = WAVE_DIRS[dirKey] or WAVE_DIRS["Вокруг острова"]
	local strength = kindData.strength * speedMult
	local freq = kindData.freq * speedMult
	local lift = kindData.lift
	local baseKind = kindData.kind
	local dirKind = dirData.kind
	local dirDeg = dirData.dir
	local centerPos
	if dirKind == "island_circle" then centerPos = ISLAND_CENTER
	else centerPos = region.cframe.Position end
	local toCenter = Vector3.new(centerPos.X - pos.X, 0, centerPos.Z - pos.Z)
	local dist = toCenter.Magnitude
	if dist > 0.1 then toCenter = toCenter / dist else toCenter = Vector3.new(0,0,0) end
	local tangent = Vector3.new(-toCenter.Z, 0, toCenter.X)
	local ang = math.rad(dirDeg)
	local sineDir = Vector3.new(math.cos(ang), 0, math.sin(ang))
	local phase = math.sin(t * freq * math.pi * 2)
	local dirFlow
	if dirKind == "flow" then dirFlow = sineDir * (strength * 0.85)
	elseif dirKind == "island_circle" then dirFlow = getIslandCircleImpulse(pos, strength)
	else dirFlow = Vector3.new(0,0,0) end
	if baseKind == "sine" then
		local bob = Vector3.new(0, lift * strength * math.abs(phase) * 0.3, 0)
		return dirFlow + bob * 0.3
	elseif baseKind == "storm" then
		local rand = Vector3.new((math.random()-0.5)*2, math.random()*1.5, (math.random()-0.5)*2)
		if rand.Magnitude > 0.1 then rand = rand.Unit else rand = Vector3.new(0,1,0) end
		return rand * strength + dirFlow * 0.3
	elseif baseKind == "tsunami" then
		local cycle = (t - waveStartTime) % 4
		if cycle < 0.4 then
			local power = strength * 3
			return Vector3.new(0, power * 1.8, 0) + (-toCenter) * power * 1.5 + dirFlow * 0.3
		end
		return dirFlow + Vector3.new(0, lift * strength * 0.3 * math.abs(phase), 0)
	elseif baseKind == "suckspit" then
		local cycle = (t - waveStartTime) % 2.4
		if cycle < 2.0 then
			return toCenter * strength * 1.5 + Vector3.new(0, -strength * 1.2, 0) + dirFlow * 0.2
		else
			local power = strength * 4
			return Vector3.new(0, power * 2, 0) + (-toCenter) * power * 1.5
		end
	end
	return dirFlow
end

local function startWaves()
	if waveActive or not physicsWaterRegion then return end
	waveActive = true
	waveStartTime = tick()
	waveConn = RunService.Heartbeat:Connect(function(dt)
		if not waveActive or not physicsWaterRegion then return end
		pcall(function()
			local t = tick()
			local region = physicsWaterRegion
			local myChar = player.Character
			for _, plr in ipairs(Players:GetPlayers()) do
				local char = plr.Character
				if char then
					local hrp = char:FindFirstChild("HumanoidRootPart")
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hrp and hum and hum.Health > 0 and isInsideRegion(hrp.Position, region) then
						local mass = hrp.AssemblyMass
						if mass <= 0 then mass = 1 end
						local imp = getWaveImpulse(region, hrp.Position, t)
						hrp:ApplyImpulse(imp * mass * dt)
						local kd = WAVE_KINDS[modeKey]
						if kd and (kd.kind == "storm" or kd.kind == "suckspit") then
							local axis = Vector3.new(math.random()-0.5, math.random()-0.5, math.random()-0.5)
							if axis.Magnitude > 0.1 then axis = axis.Unit end
							hrp:ApplyAngularImpulse(axis * kd.strength * 0.001 * mass)
						end
					end
				end
			end
			for i = 1, #stabilizedTables do
				local tbl = stabilizedTables[i]
				if tbl and tbl.Parent and tbl.PrimaryPart then
					local primary = tbl.PrimaryPart
					if isInsideRegion(primary.Position, region) then
						local mass = primary.AssemblyMass
						if mass > 0 then
							local imp = getWaveImpulse(region, primary.Position, t)
							imp = Vector3.new(imp.X, 0, imp.Z)
							primary:ApplyImpulse(imp * mass * dt)
						end
					end
				end
			end
			local parts = workspace:GetPartBoundsInBox(region.cframe, region.size)
			for _, part in ipairs(parts) do
				if part:IsA("BasePart") and not part.Anchored then
					if not myChar or not part:IsDescendantOf(myChar) then
						if not isStabilized(part) then
							local mass = part.AssemblyMass
							if mass > 0 then
								part:ApplyImpulse(getWaveImpulse(region, part.Position, t) * mass * dt * 0.5)
							end
						end
					end
				end
			end
		end)
	end)
end

local STAB_ORIENT_TAG = "StabBodyGyro"
local STAB_POS_TAG = "StabBodyPosition"
local STAB_ATTACH_TAG = "StabAttach"

local function getBottomOffset(tbl)
	local primary = tbl.PrimaryPart
	if not primary then return 0 end
	local py = primary.Position.Y
	local lowestY = py
	for _, d in ipairs(tbl:GetDescendants()) do
		if d:IsA("BasePart") then
			local bottom = d.Position.Y - d.Size.Y * 0.5
			if bottom < lowestY then lowestY = bottom end
		end
	end
	return py - lowestY
end

local function setupPhysicsForTable(tbl)
	local primary = tbl.PrimaryPart
	if not primary then return false, "no primary" end
	pcall(function()
		local oldGyro = primary:FindFirstChild(STAB_ORIENT_TAG)
		if oldGyro then oldGyro:Destroy() end
	end)
	local ok1, err1 = pcall(function()
		local bg = Instance.new("BodyGyro")
		bg.Name = STAB_ORIENT_TAG
		bg.MaxTorque = Vector3.new(UPRIGHT_TORQUE, 0, UPRIGHT_TORQUE)
		bg.P = 5000
		bg.D = 500
		bg.CFrame = CFrame.new(primary.Position)
		bg.Parent = primary
	end)
	if not ok1 then return false, "gyro: " .. tostring(err1) end
	pcall(function()
		local oldPos = primary:FindFirstChild(STAB_POS_TAG)
		if oldPos then oldPos:Destroy() end
	end)
	local ok2, err2 = pcall(function()
		local bp = Instance.new("BodyPosition")
		bp.Name = STAB_POS_TAG
		bp.MaxForce = Vector3.new(0, Y_HOLD_FORCE, 0)
		bp.P = 3000
		bp.D = 300
		if physicsWaterRegion then
			local bottomOff = getBottomOffset(tbl)
			local targetY = physicsWaterRegion.surfaceY - SUBMERGE + bottomOff
			bp.Position = Vector3.new(primary.Position.X, targetY, primary.Position.Z)
		else
			bp.Position = primary.Position
		end
		bp.Parent = primary
	end)
	if not ok2 then return false, "pos: " .. tostring(err2) end
	pcall(function()
		primary.AngularDamping = WATER_ANGULAR_DRAG
	end)
	return true
end

local function applyHorizontalDrag(primary, dt)
	if HORIZONTAL_DRAG <= 0 then return end
	local vel = primary.AssemblyLinearVelocity
	local hVel = Vector3.new(vel.X, 0, vel.Z)
	if hVel.Magnitude < 0.01 then return end
	local mass = primary.AssemblyMass
	if mass <= 0 then mass = 1 end
	primary:ApplyImpulse(-hVel * HORIZONTAL_DRAG * mass * dt)
end

local function physicsLoop()
	if physicsConn then return end
	physicsConn = RunService.Heartbeat:Connect(function(dt)
		if not physicsWaterRegion then return end
		local surfaceY = physicsWaterRegion.surfaceY
		for i = 1, #stabilizedTables do
			local tbl = stabilizedTables[i]
			if tbl and tbl.Parent and tbl.PrimaryPart then
				local primary = tbl.PrimaryPart
				local bg = primary:FindFirstChild(STAB_ORIENT_TAG)
				local bp = primary:FindFirstChild(STAB_POS_TAG)
				if bg then
					local _, yaw, _ = primary.CFrame:ToOrientation()
					pcall(function()
						bg.CFrame = CFrame.new(primary.Position) * CFrame.Angles(0, yaw, 0)
					end)
				end
				if bp then
					local bottomOff = getBottomOffset(tbl)
					local targetY = surfaceY - SUBMERGE + bottomOff
					pcall(function()
						bp.Position = Vector3.new(primary.Position.X, targetY, primary.Position.Z)
					end)
				end
				applyHorizontalDrag(primary, dt)
			end
		end
	end)
end

local function isInStabList(tbl)
	for i = 1, #stabilizedTables do
		if stabilizedTables[i] == tbl then return true end
	end
	return false
end

local function stabilizeSingleTable(tbl)
	if not tbl or not tbl.Parent then return false, "нет Parent" end
	local main = tbl:FindFirstChild("Main")
	if not main or not main:IsA("BasePart") then return false, "нет Main" end
	tbl.PrimaryPart = main
	local minY, maxY = math.huge, -math.huge
	for _, d in ipairs(tbl:GetDescendants()) do
		if d:IsA("BasePart") then
			minY = math.min(minY, d.Position.Y)
			maxY = math.max(maxY, d.Position.Y)
		end
	end
	if minY == math.huge then return false, "нет частей" end
	local midY = (minY + maxY) * 0.5
	for _, d in ipairs(tbl:GetDescendants()) do
		if d:IsA("BasePart") then
			pcall(function()
				d.Anchored = false
				d.CanCollide = true
				local isTop = d.Position.Y > midY
				local density = isTop and TOP_DENSITY or LEG_DENSITY
				d.CustomPhysicalProperties = PhysicalProperties.new(density, 0.5, 0.05, 1, 1)
			end)
		end
	end
	local ok, err = setupPhysicsForTable(tbl)
	if ok then
		table.insert(stabilizedTables, tbl)
		return true
	end
	return false, err
end

local function stabilizeTables()
	stabilizedTables = {}
	local container = workspace:FindFirstChild(CONTAINER_NAME)
	if not container then return 0, "Контейнер не найден" end
	local tables = {}
	for _, child in ipairs(container:GetChildren()) do
		if child.Name == TABLE_NAME then table.insert(tables, child) end
	end
	if #tables == 0 then return 0, "Столы не найдены" end
	local count = 0
	for i, tbl in ipairs(tables) do
		if i <= TABLES_TO_STABILIZE then
			if stabilizeSingleTable(tbl) then count += 1 end
		end
	end
	if count > 0 then physicsLoop() end
	return count, nil
end

local function startAutoStabilize()
	if autoStabConn then return end
	autoStabEnabled = true
	autoStabConn = RunService.Heartbeat:Connect(function()
		if not autoStabEnabled then return end
		if #stabilizedTables >= TABLES_TO_STABILIZE then return end
		local container = workspace:FindFirstChild(CONTAINER_NAME)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if #stabilizedTables >= TABLES_TO_STABILIZE then break end
			if child.Name == TABLE_NAME and child.Parent and not isInStabList(child) then
				stabilizeSingleTable(child)
			end
		end
	end)
end

local function stopAutoStabilize()
	autoStabEnabled = false
	if autoStabConn then autoStabConn:Disconnect() autoStabConn = nil end
end

local function unstabilizeAll()
	stopAutoStabilize()
	for i = 1, #stabilizedTables do
		local tbl = stabilizedTables[i]
		if tbl and tbl.Parent and tbl.PrimaryPart then
			pcall(function()
				local bg = tbl.PrimaryPart:FindFirstChild(STAB_ORIENT_TAG)
				if bg then bg:Destroy() end
				local bp = tbl.PrimaryPart:FindFirstChild(STAB_POS_TAG)
				if bp then bp:Destroy() end
			end)
		end
	end
	stabilizedTables = {}
	if physicsConn then physicsConn:Disconnect() physicsConn = nil end
end

