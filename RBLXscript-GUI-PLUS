local function paintOceanObject(obj, color)
	local n = 0
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("BasePart") then d.Color = color n += 1 end
	end
	return n
end

local TEXTURE_TAG = "CustomOceanTexture"
local function applyOceanTexture(obj, id)
	local n = 0
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("BasePart") then
			local old = d:FindFirstChild(TEXTURE_TAG)
			if old then old:Destroy() end
			local tex = Instance.new("Texture")
			tex.Name = TEXTURE_TAG
			tex.Texture = id
			tex.Face = Enum.NormalId.Top
			tex.StudsPerTileU = OCEAN_TEXTURE_STUDS
			tex.StudsPerTileV = OCEAN_TEXTURE_STUDS
			tex.Transparency = 0
			tex.Parent = d
			n += 1
		end
	end
	return n
end
local function removeOceanTexture(obj)
	local n = 0
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("BasePart") then
			local old = d:FindFirstChild(TEXTURE_TAG)
			if old then old:Destroy() n += 1 end
		end
	end
	return n
end

local function getOceanBoundingBox(obj)
	local mn, mx
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("BasePart") then
			local h = d.Size * 0.5
			local a = d.Position - h
			local b = d.Position + h
			if not mn then mn, mx = a, b
			else
				mn = Vector3.new(math.min(mn.X,a.X), math.min(mn.Y,a.Y), math.min(mn.Z,a.Z))
				mx = Vector3.new(math.max(mx.X,b.X), math.max(mx.Y,b.Y), math.max(mx.Z,b.Z))
			end
		end
	end
	return mn, mx
end

local function buildPhysicsWater(obj)
	saveWaterState()
	local mn, mx = getOceanBoundingBox(obj)
	if not mn then return nil end
	local surfaceY = mx.Y + WATER_SURFACE_OFFSET
	local bottomY = surfaceY - WATER_DEPTH
	local center = Vector3.new((mn.X+mx.X)*0.5, (surfaceY+bottomY)*0.5, (mn.Z+mx.Z)*0.5)
	local size = Vector3.new((mx.X-mn.X)+WATER_PADDING*2, WATER_DEPTH, (mx.Z-mn.Z)+WATER_PADDING*2)
	local cf = CFrame.new(center)
	workspace.Terrain:FillBlock(cf, size, Enum.Material.Water)
	return {cframe=cf, size=size, surfaceY=surfaceY}
end

local function clearPhysicsWater()
	if not physicsWaterRegion then return end
	workspace.Terrain:FillBlock(physicsWaterRegion.cframe, physicsWaterRegion.size, Enum.Material.Air)
	physicsWaterRegion = nil
	restoreWaterState()
end

local function isInsideRegion(pos, region)
	if not region then return false end
	local c = region.cframe.Position
	local h = region.size * 0.5
	return math.abs(pos.X-c.X)<=h.X and math.abs(pos.Y-c.Y)<=h.Y and math.abs(pos.Z-c.Z)<=h.Z
end

local function isStabilized(part)
	for i = 1, #stabilizedTables do
		local obj = stabilizedTables[i]
		if obj == part or (obj:IsA("Model") and part:IsDescendantOf(obj)) then return true end
	end
	return false
end

