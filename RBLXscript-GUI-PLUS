	local t = workspace.Terrain
	savedWaterState = {
		WaterColor = t.WaterColor, WaterTransparency = t.WaterTransparency,
		WaterReflectance = t.WaterReflectance, WaterWaveSize = t.WaterWaveSize,
		WaterWaveSpeed = t.WaterWaveSpeed,
	}
end
local function restoreWaterState()
	if not savedWaterState then return end
	local t = workspace.Terrain
	t.WaterColor = savedWaterState.WaterColor
	t.WaterTransparency = savedWaterState.WaterTransparency
	t.WaterReflectance = savedWaterState.WaterReflectance
	t.WaterWaveSize = savedWaterState.WaterWaveSize
	t.WaterWaveSpeed = savedWaterState.WaterWaveSpeed
	savedWaterState = nil
end

