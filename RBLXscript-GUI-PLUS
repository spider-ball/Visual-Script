local function clearVisualPreset()
	for _, o in ipairs(Lighting:GetChildren()) do
		if o:GetAttribute(VISUAL_TAG) == true then o:Destroy() end
	end
	for _, o in ipairs(Lighting:GetChildren()) do
		if o:IsA("Atmosphere") or o:IsA("BloomEffect") or o:IsA("ColorCorrectionEffect") or o:IsA("SunRaysEffect") or o:IsA("BlurEffect") or o:IsA("DepthOfFieldEffect") then o:Destroy() end
	end
end
local function resetLighting()
	for k, v in pairs(ORIG_LIGHTING) do Lighting[k] = v end
end
