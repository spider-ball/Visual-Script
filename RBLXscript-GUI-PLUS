local function populateSkiesCard(body)
	for i, d in ipairs(SKY_LIST) do
		local b = createListButton(body, d[2], i)
		skyButtons[i] = b
		skyButtonByKey[d[1]] = b
		b.MouseButton1Click:Connect(function()
			local tex = SKY_TEXTURES[d[1]]
			if tex then applyCustomSky(d[1], tex, b) else applyDefaultSky() end
			saveSettingsDelayed()
		end)
	end
	setActiveSkyButton(skyButtonByKey["DefaultSky"])
end

local function populateEffectsCard(body)
	local function refresh()
		for name, button in pairs(visualButtons) do
			local act = (name == "None")
			button.BackgroundColor3 = act and Color3.fromRGB(252,207,242) or BTN_COLOR
			button.TextColor3 = act and Color3.fromRGB(0,0,0) or Color3.fromRGB(255,255,255)
		end
	end
	for i, data in ipairs(visualPresets) do
		local b = createListButton(body, data[2], i)
		visualButtons[data[1]] = b
		b.MouseButton1Click:Connect(function()
			applyVisualPreset(data[1])
			for name, button in pairs(visualButtons) do
				local act = (name == data[1])
				button.BackgroundColor3 = act and Color3.fromRGB(252,207,242) or BTN_COLOR
				button.TextColor3 = act and Color3.fromRGB(0,0,0) or Color3.fromRGB(255,255,255)
			end
			saveSettingsDelayed()
		end)
	end
	local rmBtn = createListButton(body, "Убрать все эффекты", #visualPresets + 1)
	rmBtn.MouseButton1Click:Connect(function()
		clearVisualPreset(); resetLighting(); refresh()
		rmBtn.Text = "Эффекты убраны"
		task.delay(1.5, function() if rmBtn.Parent then rmBtn.Text = "Убрать все эффекты" end end)
		saveSettingsDelayed()
	end)
	refresh()
end

