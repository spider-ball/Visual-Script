-- HIDE PROPS MODULE (MapProps + DeadTree children)
-- ============================================================
local HideProps = (function()
	local hidden = false
	local propsSaved = nil      -- { obj, parent }
	local treeSaved = {}        -- child -> parent

	local function findMapProps()
		local map = workspace:FindFirstChild("Map")
		if not map then return nil end
		return map:FindFirstChild("MapProps")
	end

	local function findDeadTrees()
		local map = workspace:FindFirstChild("Map")
		if not map then return {} end
		local bg = map:FindFirstChild("BaseGround")
		if not bg then return {} end
		local list = {}
		for _, ch in ipairs(bg:GetChildren()) do
			if ch.Name == "DeadTree" or ch.Name:match("^DeadTree%d*$") then
				table.insert(list, ch)
			end
		end
		return list
	end

	local function hide()
		local info = {}

		-- MapProps
		local props = findMapProps()
		if props then
			propsSaved = { obj = props, parent = props.Parent }
			props.Parent = nil
			info.props = true
		else
			info.props = false
		end

		-- DeadTree children
		treeSaved = {}
		local trees = findDeadTrees()
		local childCount = 0
		for _, tree in ipairs(trees) do
			for _, child in ipairs(tree:GetChildren()) do
				treeSaved[child] = child.Parent
				child.Parent = nil
				childCount += 1
			end
		end
		info.trees = #trees
		info.children = childCount

		return info
	end

	local function restore()
		local info = { props = false, children = 0 }

		if propsSaved and propsSaved.obj and propsSaved.parent and propsSaved.parent.Parent then
			propsSaved.obj.Parent = propsSaved.parent
			propsSaved = nil
			info.props = true
		end

		for child, parent in pairs(treeSaved) do
			if parent and parent.Parent then
				child.Parent = parent
				info.children += 1
			end
		end
		treeSaved = {}

		return info
	end

	return {
		state = { hidden = false },
		hide = function()
			local info = hide()
			hidden = true
			return info
		end,
		restore = function()
			local info = restore()
			hidden = false
			return info
		end,
		isHidden = function() return hidden end,
	}
end)()

getgenv().HideProps = {
	Hide = function() return HideProps.hide() end,
	Restore = function() return HideProps.restore() end,
	IsHidden = function() return HideProps.isHidden() end,
}

