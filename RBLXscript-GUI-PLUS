		if obj then removeOceanTexture(obj) end
		stopWaves(); unstabilizeAll(); clearPhysicsWater(); restoreWaterState()
		resetBtn.Text = "Готово"
		task.delay(1.5, function() if resetBtn.Parent then resetBtn.Text = "Сбросить настройки" end end)
		saveSettingsDelayed()
	end)

	local destroyBtn = createListButton(body, "Удалить скрипт", 2)
