-- ============================================================
local AntiLag = (function()
	local state = {
		Enabled = false, AutoEnabled = true, LastCheck = 0, FPS = 60,
		ENABLE_FPS = 20, DISABLE_FPS = 45, CHECK_INTERVAL = 2.5, CLEANUP_DELAY = 1.5,
	}
	local function apply(on)
		if state.Enabled == on then return end
		state.Enabled = on
		local ps = player:FindFirstChild("PlayerScripts")
		if not ps then return end
		local beamMove = ps:FindFirstChild("CharacterAndBeamMove")
		local stickyTouch = ps:FindFirstChild("StickyPartsTouchDetection")
		if beamMove then beamMove.Enabled = not on end
		if stickyTouch then stickyTouch.Enabled = not on end
		if on then
			task.delay(state.CLEANUP_DELAY, function()
				if not state.Enabled then return end
				for _, plr in ipairs(Players:GetPlayers()) do
					local char = plr.Character
					if char then
						for _, child in ipairs(char:GetChildren()) do
							if child.Name == "GrabParts" then child:Destroy() end
						end
					end
				end
			end)
		end
	end
	local frameCount = 0
	local fpsTimer = os.clock()
	RunService.Heartbeat:Connect(function()
		frameCount += 1
		local now = os.clock()
		if now - fpsTimer >= 1 then
			state.FPS = math.floor(frameCount / (now - fpsTimer))
			frameCount = 0
			fpsTimer = now
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		if not state.AutoEnabled then return end
		if dt <= 0 then return end
		local now = os.clock()
		if now - state.LastCheck < state.CHECK_INTERVAL then return end
		state.LastCheck = now
		if not state.Enabled and state.FPS < state.ENABLE_FPS then
			apply(true)
		elseif state.Enabled and state.FPS > state.DISABLE_FPS then
			apply(false)
		end
	end)
	return {
		state = state, apply = apply,
		setAuto = function(v) state.AutoEnabled = v end,
		toggleManual = function() state.AutoEnabled = false; apply(not state.Enabled) end,
		getFPS = function() return state.FPS end,
		isEnabled = function() return state.Enabled end,
		isAuto = function() return state.AutoEnabled end,
		setThresholds = function(en, dis) if en then state.ENABLE_FPS = en end if dis then state.DISABLE_FPS = dis end end,
	}
end)()

getgenv().AutoAntiLineLag = {
	Enable = function() AntiLag.apply(true) end,
	Disable = function() AntiLag.apply(false) end,
	Toggle = function() AntiLag.apply(not AntiLag.state.Enabled) end,
	IsOn = function() return AntiLag.state.Enabled end,
	GetFPS = function() return AntiLag.state.FPS end,
	SetThresholds = AntiLag.setThresholds,
}

