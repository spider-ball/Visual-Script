-- BREAK PCLD MODULE (Local / Network / Both)
-- ============================================================
local BreakPCLD = (function()
	local state = {
		Active = false,
		Mode = "Both",           -- Local | Network | Both
		Interval = 1.0,
		LastRun = 0,
	}

	local function isPCLDPart(part)
		if not part or not part:IsA("BasePart") then return false end
		local n = part.Name:lower()
		return n == "playercharacterlocationdetector" or n == "partesp"
	end

	local function getSetNetworkOwner()
		local ge = ReplicatedStorage:FindFirstChild("GrabEvents")
		return ge and ge:FindFirstChild("SetNetworkOwner")
	end

	local function waitOwnership(part, timeout)
		timeout = timeout or 1.0
		local t0 = tick()
		while tick() - t0 < timeout do
			local ok, owner = pcall(function() return part:GetNetworkOwner() end)
			if ok and owner == player then return true end
			RunService.Heartbeat:Wait()
		end
		return false
	end

	local function breakLocal()
		local count = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if isPCLDPart(d) then
				pcall(function()
					d.CanCollide = false
					d.CanTouch = false
					d.CanQuery = false
					d.Massless = true
					d.Transparency = 1
					d.Anchored = true
					d.CFrame = CFrame.new(0, -10000, 0)
					d.AssemblyLinearVelocity = Vector3.zero
					d.AssemblyAngularVelocity = Vector3.zero
				end)
				count += 1
			end
		end
		return count
	end

	local function breakNetwork()
		local setNet = getSetNetworkOwner()
		if not setNet then return 0 end
		local count = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if isPCLDPart(d) then
				count += 1
				task.spawn(function()
					pcall(function() setNet:FireServer(d, d.CFrame) end)
					waitOwnership(d, 1.0)
					pcall(function()
						local killCF = CFrame.new(0, -9000, 0)
						for i = 1, 10 do
							pcall(function() setNet:FireServer(d, killCF) end)
							pcall(function()
								if d.Parent then
									d.CFrame = killCF
									d.AssemblyLinearVelocity = Vector3.new(0, -3000, 0)
									d.AssemblyAngularVelocity = Vector3.zero
								end
							end)
							RunService.Heartbeat:Wait()
						end
						if d.Parent then
							d.CanCollide = false
							d.CanTouch = false
							d.CanQuery = false
							d.Transparency = 1
							d.Anchored = true
						end
					end)
				end)
				task.wait(0.03)
			end
		end
		return count
	end

	local function run(mode)
		mode = mode or state.Mode
		if mode == "Local" then
			return breakLocal()
		elseif mode == "Network" then
			return breakNetwork()
		else
			local a = breakNetwork()
			task.wait(0.1)
			local b = breakLocal()
			return math.max(a, b)
		end
	end

	task.spawn(function()
		while task.wait(0.15) do
			if state.Active and tick() - state.LastRun >= state.Interval then
				state.LastRun = tick()
				pcall(run)
			end
		end
	end)

	workspace.DescendantAdded:Connect(function(desc)
		if not state.Active then return end
		if not isPCLDPart(desc) then return end
		task.defer(function()
			if state.Mode == "Local" then
				pcall(function()
					desc.CanCollide = false
					desc.CanTouch = false
					desc.CanQuery = false
					desc.Massless = true
					desc.Transparency = 1
					desc.Anchored = true
					desc.CFrame = CFrame.new(0, -10000, 0)
				end)
			else
				pcall(run)
			end
		end)
	end)

	return {
		state = state,
		run = run,
		setActive = function(v) state.Active = v end,
		setMode = function(m) state.Mode = m end,
		setInterval = function(i) state.Interval = math.clamp(i, 0.2, 10) end,
		isActive = function() return state.Active end,
		getMode = function() return state.Mode end,
	}
end)()

getgenv().BreakPCLD = {
	Run = function() return BreakPCLD.run() end,
	Enable = function() BreakPCLD.setActive(true) end,
	Disable = function() BreakPCLD.setActive(false) end,
	IsOn = function() return BreakPCLD.isActive() end,
	SetMode = BreakPCLD.setMode,
	SetInterval = BreakPCLD.setInterval,
}

