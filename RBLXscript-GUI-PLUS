-- NO BARRIER COLLISION MODULE (обновлено: отключает все коллизии)
-- ============================================================
local NoBarrier = (function()
	local active = false
	local function collectParts(plot)
		local parts = {}
		local seen = {}
		local function addPart(p)
			if p and p:IsA("BasePart") and not seen[p] then
				seen[p] = true
				table.insert(parts, p)
			end
		end
		local plotArea = plot:FindFirstChild("PlotArea")
		if plotArea then
			addPart(plotArea)
			for _, d in ipairs(plotArea:GetDescendants()) do addPart(d) end
		end
		local barrier = plot:FindFirstChild("Barrier")
		if barrier then
			addPart(barrier)
			for _, d in ipairs(barrier:GetDescendants()) do addPart(d) end
		end
		return parts
	end

	local function setBarrierCollision(state)
		local plots = workspace:FindFirstChild("Plots")
		if not plots then return 0 end
		local count = 0
		for _, plot in ipairs(plots:GetChildren()) do
			local parts = collectParts(plot)
			for _, part in ipairs(parts) do
				pcall(function() part.CanCollide = state end)
				pcall(function() part.CanTouch = state end)
				pcall(function() part.CanQuery = state end)
				pcall(function() part.AudioCanCollide = state end)
				count += 1
			end
		end
		return count
	end

	task.spawn(function()
		while task.wait(1) do
			if active then
				pcall(function() setBarrierCollision(false) end)
			end
		end
	end)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		if active then
			pcall(function() setBarrierCollision(false) end)
		end
	end)
	return {
		setActive = function(v)
			active = v
			return setBarrierCollision(not v)
		end,
		isActive = function() return active end,
	}
end)()

getgenv().NoBarrierCollision = {
	Enable = function() return NoBarrier.setActive(true) end,
	Disable = function() return NoBarrier.setActive(false) end,
	IsOn = function() return NoBarrier.isActive() end,
}

