	local function destroyScript()
		clearCustomSky(); clearVisualPreset()
		if originalSky and not originalSky.Parent then originalSky.Parent = Lighting end
		if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = 70 end
		if removedOcean and savedOceanParent and savedOceanParent.Parent then removedOcean.Parent = savedOceanParent end
		local obj = findOceanObject()
		if obj then removeOceanTexture(obj) end
		stopWaves(); unstabilizeAll(); clearPhysicsWater(); restoreWaterState()
		NoBarrier.setActive(false)
		BarrierBreak.stopAuto()
		BreakPCLD.setActive(false)
		HideProps.restore() -- Восстанавливаем скрытые объекты при удалении
		_G[SCRIPT_TAG] = nil
		screenGui:Destroy()
	end
	destroyBtn.MouseButton1Click:Connect(function()
		if not confirmDestroy then
			confirmDestroy = true
			destroyBtn.Text = "Нажми ещё раз"
			destroyBtn.BackgroundColor3 = Color3.fromRGB(80,0,0)
			task.delay(3, function()
